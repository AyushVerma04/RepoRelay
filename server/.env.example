# =================================================================
# RepoRelay Backend Environment Configuration Template
# For production deployment on Render / Railway / Cloud Containers
# =================================================================

# Server Port (Render sets this dynamically via process.env.PORT)
PORT=5000

# Groq LLM API Key for repository architecture intelligence and security analysis
GROQ_API_KEY=gsk_your_groq_api_key_here

# GitHub Personal Access Token (PAT)
# Recommended to prevent GitHub API rate limits (60 req/hr -> 5000 req/hr) and clone private repos
GITHUB_TOKEN=ghp_your_github_token_here

# MongoDB Atlas Connection String
# IMPORTANT: In MongoDB Atlas > Network Access, ensure 0.0.0.0/0 (Allow from Anywhere) is whitelisted.
# Also ensure the cluster is NOT in a paused state.
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/reporelay?retryWrites=true&w=majority

# JWT Secret for authentication tokens
JWT_SECRET=replace_with_a_secure_random_jwt_secret_here

# Client URL (Vercel Frontend production URL for CORS validation)
CLIENT_URL=https://your-reporelay.vercel.app
FRONTEND_URL=https://your-reporelay.vercel.app
